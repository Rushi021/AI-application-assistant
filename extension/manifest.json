{
  "manifest_version": 3,
  "name": "AI Job Application Assistant",
  "version": "0.2.0",
  "description": "Prepare matched application packets, review documents, approve, and oversee ATS autofill.",
  "action": {
    "default_title": "Job Application Assistant",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ]
}
