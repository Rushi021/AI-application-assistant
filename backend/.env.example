APP_NAME="AI Job Application Assistant"
ENVIRONMENT="development"

DATABASE_URL="sqlite:///./app.db"

STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/resumes"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="pdf,doc,docx"

# Output paths for generated/tailored files saved to local machine
OUTPUT_RESUME_PATH="E:\\rushi\\storage - resume\\resumes"
OUTPUT_COVER_LETTER_PATH="E:\\rushi\\storage - resume\\cover letters"

# Legacy test auth (kept for backward compat)
TEST_USERNAME="testuser"
TEST_PASSWORD="testpass"
TEST_TOKEN="test-token"

# Google OAuth (get from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# JWT settings
JWT_SECRET_KEY="change-me-in-production-use-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Gemini / Google AI Studio (replace with real key)
GOOGLE_AI_API_KEY="your-google-ai-studio-api-key"
GEMINI_MODEL="gemini-1.5-flash"
