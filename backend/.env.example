APP_NAME="AI Job Application Assistant"
ENVIRONMENT="development"

# Database
# Development default is SQLite; set a Postgres URL in production.
DATABASE_URL="sqlite:///./app.db"

# Security
# Unsafe for production. Replace with a long random value.
SECRET_KEY="local-dev-secret-do-not-use-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth
# Required in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WEB_REDIRECT_URI="http://localhost:8000/auth/web/google/callback"
WEB_APP_URL="http://localhost:8501"
WEB_LOGIN_CODE_TTL_SECONDS=300

# Storage
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/resumes"

# S3 / Cloudflare R2 (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL=""
S3_BUCKET_NAME="resumes"

# Optional API key encryption for external provider keys
API_KEY_ENCRYPTION_KEY=""

# CORS
# Comma-separated web origins. Chrome-extension origins are handled dynamically.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
ADMIN_EMAILS="admin@example.com"

# Upload rules
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="pdf,doc,docx"

# Output paths for generated/tailored files saved to local machine
OUTPUT_RESUME_PATH="E:\\rushi\\storage - resume\\resumes"
OUTPUT_COVER_LETTER_PATH="E:\\rushi\\storage - resume\\cover letters"

# Legacy test auth (kept for backward compat)
TEST_USERNAME="testuser"
TEST_PASSWORD="testpass"
TEST_TOKEN="test-token"

# Gemini / Google AI Studio (replace with real key)
GOOGLE_AI_API_KEY="your-google-ai-studio-api-key"
GEMINI_MODEL="gemini-1.5-flash"
