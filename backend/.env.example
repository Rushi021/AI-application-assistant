APP_NAME="AI Job Application Assistant"
ENVIRONMENT="development"

DATABASE_URL="sqlite:///./app.db"

STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/resumes"
OUTPUT_DIR="./data/output"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="pdf,doc,docx,tex"

TEST_USERNAME="testuser"
TEST_PASSWORD="testpass"
TEST_TOKEN="test-token"

# Per-task routing: provider:model. Empty override uses the default.
LLM_DEFAULT="gemini:gemini-1.5-flash"
LLM_JD_EXTRACTION=""
LLM_RESUME_TAILOR="gemini:gemini-1.5-pro"
LLM_BULLET_REWRITE=""
LLM_COVER_LETTER=""
EMBEDDING_DEFAULT="gemini:text-embedding-004"
EMBEDDING_REQUIREMENT=""
EMBEDDING_RESUME=""

# Credentials are only required for providers a spec actually selects.
GOOGLE_AI_API_KEY="your-google-ai-studio-api-key"
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

MODEL_MAX_RETRIES=2
MODEL_TIMEOUT_SECONDS=60

SEMANTIC_THRESHOLD=0.72
MUST_HAVE_WEIGHT=1.0
NICE_TO_HAVE_WEIGHT=0.4
TIER2_CONFIDENCE_FACTOR=0.85

LATEX_COMPILER="tectonic"
SCRAPER_PROVIDER="noop"
